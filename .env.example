# Copy to .env and fill in.

# Anthropic API key (https://console.anthropic.com). Powers the AI builder and every bot's brain.
ANTHROPIC_API_KEY=sk-ant-...

# Password for the dashboard. Required.
ADMIN_PASSWORD=change-me

# Long random string. Signs dashboard sessions and encrypts stored bot tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Where the dashboard listens. Keep 127.0.0.1 unless it sits behind a reverse proxy with HTTPS.
HOST=127.0.0.1
PORT=3000

# Where bots and their data (levels, coins, warnings, giveaways) are stored.
DATA_DIR=./data
